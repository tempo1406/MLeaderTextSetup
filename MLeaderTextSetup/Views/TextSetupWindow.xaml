<Window x:Class="MLeaderTextSetup.Views.TextSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MLeaderTextSetup.Views"
        mc:Ignorable="d"
        Title="Cấu hình hiển thị Text (Setup)" Height="450" Width="800"
        Background="#F5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!--#region Format Text-->
        <GroupBox Padding="12" FontWeight="Bold">
            <GroupBox.Header>
                <TextBlock Text="ĐỊNH DẠNG TEXT" Foreground="#0078D7" FontWeight="Bold"/>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Font chữ:" FontWeight="Normal"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding TextStyles}"
                          SelectedItem="{Binding TextStyleName}"
                          Height="30"/>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,12,0,0" Text="Cỡ chữ (Text Height):" FontWeight="Normal"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                         Text="{Binding TextHeight, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,12,0,0" Text="Màu sắc Layer:" FontWeight="Normal"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Height="30"
                          ItemsSource="{Binding ColorItems}"
                          SelectedItem="{Binding SelectedColorItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" Background="{Binding ColorBrush}" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </GroupBox>
        <!--#endregion-->

        <!--#region Preview-->
        <GroupBox Grid.Row="1" Padding="12" Margin="0,12,0,0" FontWeight="Bold" Foreground="#0078D7">
            <GroupBox.Header>
                <TextBlock Text="XEM TRƯỚC (PREVIEW)" Foreground="#0078D7" FontWeight="Bold"/>
            </GroupBox.Header>
            <Border Background="#1E1E1E" CornerRadius="6" Padding="14" Height="100">
                <TextBlock Text="{Binding PreviewText}"
                           Foreground="{Binding SelectedColorItem.ColorBrush}"
                           FontSize="20"
                           FontWeight="Normal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>
        </GroupBox>
        <!--#endregion-->

        <!--#region Button-->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Mặc định" Width="100" Height="38" Margin="0,0,8,0"
                    Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                    Command="{Binding DefaultCommand}" FontWeight="SemiBold"/>
            <Button Grid.Column="2" Content="Vẽ" Width="100" Height="38" Margin="0,0,8,0"
                    Background="#0078D7" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Command="{Binding DrawCommand}"/>
            <Button Grid.Column="5" Content="Đóng" Width="100" Height="38"
                    Background="#DC3545" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Command="{Binding CloseCommand}"/>
        </Grid>
        <!--#endregion-->
    </Grid>
</Window>
